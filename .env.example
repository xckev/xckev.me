# Rename this file to .env.local
# Get Spotify client ID and secret from creating a developer app at https://developer.spotify.com/
# Get Spotify refresh token from https://spotify-refresh-token-generator.netlify.app/
SPOTIFY_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SPOTIFY_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SPOTIFY_REFRESH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Generate JOURNAL_JWT_SECRET with: openssl rand -base64 32
JOURNAL_PASSWORD=your_journal_password
JOURNAL_JWT_SECRET=your_32_plus_char_random_secret
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=journal